{
  "name": "minute-book",
  "description": "Records Google Meet calls, transcribes them with Gemini and files them into Notion.",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "postinstall": "wxt prepare",
    "shots": "UI_SHOTS=1 vitest run --project visual"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/browser-playwright": "^5.0.1",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^5.0.1",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "packageManager": "pnpm@10.33.0"
}
